{
  "manifest_version": 3,
  "name": "DUMBER — AI 高刺激内容策展",
  "version": "0.3.10",
  "description": "真诚挑选、优化并推广 X 信息流中的高刺激、低持久价值内容。",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "DUMBER",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    },
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/shared.js",
        "src/adapters/index.js",
        "src/adapters/x.js",
        "src/renderer.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
